# Configure in .env.local; Next.js and CLI scripts load it before .env.
# Use development/test provider instances. Never paste private credentials in chat.
# Secret used to encrypt and sign Better Auth session tokens and cookies.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# MongoDB Atlas replica set; use a separate bookified_test database for external verification.
MONGODB_URI=
# Read/write token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Server-only Vapi private key and saved assistant. No browser Vapi key is used.
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Model ID supported by your configured saved assistant/provider (no invented default).
VAPI_MODEL_ID=
# Random >=32-byte webhook bearer secret; server supplies it via server.headers.
VAPI_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
# JSON array of account-verified choices. Empty deliberately: no invented voice IDs.
# [{"id":"your-persona-slug","name":"Display name","description":"Voice description","provider":"openai","voiceId":"account-verified-id"}]
VOICE_CATALOG_JSON=[]
# Safety bounds: worker kills extraction subprocess after 120s with a 768 MiB JS heap.
PDF_MAX_PAGES=1000

# Optional Google OAuth; enable only after configuring the hosted callback origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel production only: independent random secrets for queue messages and cron recovery.
BOOKIFIED_QUEUE_SECRET=
CRON_SECRET=

# Hubtel Online Checkout. Keep disabled until eligible merchant onboarding,
# status-API IP access, prices and live verification have been approved.
# Server-only keys: configure via secure editor/Vercel dashboard, never chat.
HUBTEL_PAYMENTS_ENABLED=false
HUBTEL_STATUS_ACCESS_CONFIRMED=false
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
# One-month prices in pesewas (integer GHS minor units); no invented defaults.
BILLING_STANDARD_AMOUNT_MINOR=
BILLING_PRO_AMOUNT_MINOR=

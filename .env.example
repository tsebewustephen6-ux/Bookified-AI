# Configure in .env.local; Next.js and CLI scripts load it before .env.
# Use development/test provider instances. Never paste private credentials in chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# MongoDB Atlas replica set; use a separate bookified_test database for external verification.
MONGODB_URI=
# Read/write token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Server-only Vapi private key and saved assistant. No browser Vapi key is used.
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Model ID supported by your configured saved assistant/provider (no invented default).
VAPI_MODEL_ID=
# Random >=32-byte webhook bearer secret; server supplies it via server.headers.
VAPI_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
# JSON array of account-verified choices. Empty deliberately: no invented voice IDs.
# [{"id":"your-persona-slug","name":"Display name","description":"Voice description","provider":"openai","voiceId":"account-verified-id"}]
VOICE_CATALOG_JSON=[]
# Safety bounds: worker kills extraction subprocess after 120s with a 768 MiB JS heap.
PDF_MAX_PAGES=1000
